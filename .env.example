# Telegram
# Get API_ID and API_HASH from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram channel IDs. Use negative channel IDs, for example the value
# returned by @userinfobot when forwarding a message from the channel.
CANAL_1_ID=
CANAL_2_ID=

# Google Gemini
# Create an API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# MetaTrader 5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Trading
LOT_SIZE=0.01
DCA_STEP=1.0

# Canal 1 stickers. Leave blank until the first bot startup prints unknown IDs.
CANAL1_BUY_STICKER_ID=
CANAL1_SELL_STICKER_ID=

# Notifications
# Empty token means notifications use the Telethon client instead of Bot API.
TELEGRAM_BOT_TOKEN=
NOTIFY_CHAT_ID=me

